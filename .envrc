# Loaded by direnv. Claude Code expands these in .mcp.json and passes them to plugin MCP servers,
# so launch `claude` from a shell inside this directory.

# No trailing slash: .mcp.json appends /api/mcp
export HA_URL=https://homeassistant.alpine-ling.ts.net
# Dev server fallback for the runtime config.json the container writes.
export VITE_HA_URL="$HA_URL"

export UNIFI_NETWORK_HOST=10.10.20.1
# Read-only by default: mutations need confirmation and create/update/delete are off.
export UNIFI_NETWORK_TOOL_PERMISSION_MODE=confirm
export UNIFI_POLICY_NETWORK_CREATE=false
export UNIFI_POLICY_NETWORK_UPDATE=false
export UNIFI_POLICY_NETWORK_DELETE=false

# Secrets (gitignored): HA_TOKEN, HA_MCP_URL, UNIFI_NETWORK_USERNAME, UNIFI_NETWORK_PASSWORD
dotenv_if_exists .env.local
