# Copy to .env.local and fill in. Never commit .env.local.

# HA profile -> Security -> Long-lived access tokens
HA_TOKEN=
# Settings -> Devices & Services -> HA-MCP Custom Component -> HA-MCP Server -> Configure
HA_MCP_URL=
# Local UniFi admin without MFA (not a Ubiquiti SSO account)
UNIFI_NETWORK_USERNAME=
UNIFI_NETWORK_PASSWORD=
